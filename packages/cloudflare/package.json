{
  "name": "@package-broker/cloudflare",
  "version": "0.10.0",
  "description": "Interactive CLI tool for deploying PACKAGE.broker to Cloudflare Workers",
  "type": "module",
  "bin": {
    "package-broker-cloudflare": "./dist/index.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "lint": "echo 'no linting configured'",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@package-broker/main": "^0.10.0",
    "execa": "^9.6.1",
    "prompts": "^2.4.2",
    "wrangler": "^4.14.1"
  },
  "devDependencies": {
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^20.19.27",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/package-broker/server",
    "directory": "packages/cloudflare"
  },
  "publishConfig": {
    "access": "public"
  }
}
