{
  "name": "@package-broker/main",
  "version": "0.19.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "wrangler.example.toml",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "lint": "echo 'no linting configured'",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@package-broker/core": "^0.19.3",
    "@package-broker/ui": "^0.19.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260108.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/package-broker/server",
    "directory": "packages/main"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
