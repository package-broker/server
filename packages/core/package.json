{
  "name": "@package-broker/core",
  "version": "0.10.7",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "lint": "echo 'no linting configured'",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "@noble/hashes": "^2.0.1",
    "@package-broker/shared": "^0.10.0",
    "@types/nodemailer": "^7.0.4",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.2",
    "hono": "^4.11.3",
    "micromatch": "^4.0.8",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.12",
    "otplib": "^12.0.1",
    "p-retry": "^7.1.1",
    "qrcode": "^1.5.4",
    "semver": "^7.7.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251230.0",
    "@types/micromatch": "^4.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/package-broker/server",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
